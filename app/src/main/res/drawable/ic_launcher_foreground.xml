<?xml version="1.0" encoding="utf-8"?>
<!-- Planet + orbit + slung moon. Content kept inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- planet glow -->
    <path android:pathData="M54,54m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#66FF5FA2" android:offset="0.55" />
                <item android:color="#00FF5FA2" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- orbit ring -->
    <path
        android:pathData="M54,54m-27,0a27,27 0,1 1,54 0a27,27 0,1 1,-54 0"
        android:strokeWidth="1.6"
        android:strokeColor="#55FFFFFF" />
    <!-- planet body -->
    <path android:pathData="M54,54m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="49"
                android:centerY="48"
                android:gradientRadius="20"
                android:type="radial">
                <item android:color="#FFFFE3F0" android:offset="0" />
                <item android:color="#FFFF5FA2" android:offset="0.5" />
                <item android:color="#FFA02A63" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#33000000" android:pathData="M59,58m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
    <path android:fillColor="#26000000" android:pathData="M50,61m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0" />
    <!-- trail along the orbit -->
    <path
        android:pathData="M30.6,40.5A27,27 0,0 1,73.1 34.9"
        android:strokeWidth="3.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="73"
                android:endY="35"
                android:startX="30"
                android:startY="40"
                android:type="linear">
                <item android:color="#00D9D2FF" android:offset="0" />
                <item android:color="#DDD9D2FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- moon -->
    <path android:fillColor="#40FFFFFF" android:pathData="M73.1,34.9m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M73.1,34.9m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />
</vector>
